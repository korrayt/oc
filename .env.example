# ============================================================
# OC — Environment Variables Example
# Copy this file to .env (or .env.local) and fill in values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Admin Identity ---
# Used by scripts/core-host-api.mjs (Node/server-side)
COREI_ADMIN_EMAIL=admin@example.com
COREI_ADMIN_PHONE=+905XXXXXXXXX

# Used by src/App.tsx (Vite/browser-side — must be prefixed VITE_)
VITE_COREI_ADMIN_PHONE=+905XXXXXXXXX

# --- Recovery Questions (optional overrides) ---
COREI_RECOVERY_QUESTION_1=Master persona başlığının ilk kelimesi nedir?
COREI_RECOVERY_QUESTION_2=Admin telefonunun son 4 hanesi nedir?
